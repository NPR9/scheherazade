# Scheherazade env vars — paste these into Vercel project settings

# Telegram
TELEGRAM_BOT_TOKEN=         # from @BotFather
TELEGRAM_WEBHOOK_SECRET=    # random string, matches webhook setup
TELEGRAM_ALLOWED_USER_ID=   # your numeric Telegram user ID (@userinfobot)

# LLM — primary (Google AI Studio, free)
GEMINI_API_KEY=             # https://aistudio.google.com/apikey

# LLM — fallback (Groq free)
GROQ_API_KEY=               # https://console.groq.com/keys

# Google Drive (service account, free)
GOOGLE_SERVICE_ACCOUNT_JSON=    # paste full JSON content as single-line string
GOOGLE_DRIVE_FOLDER_ID=         # the Scheherazade/ folder ID from URL

# Cron auth
CRON_SECRET=                # random string, external scheduler must send it

# Optional: Claude API (ONLY if you move to hybrid later — keep empty for pure-free)
# ANTHROPIC_API_KEY=
